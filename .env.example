# =============================================================================
# CONFIGURATION DU CHATBOT GEMINI
# =============================================================================
# 1. Obtenez votre clé API 100% GRATUITE sur : https://aistudio.google.com/
# 2. Cliquez sur "Get API key" puis "Create API key"
# 3. Copiez ce fichier sous le nom '.env' (sans .example)
# 4. Collez votre clé ci-dessous :

GEMINI_API_KEY=votre_cle_api_ici

# Modèle recommandé (rapide, gratuit et précis pour le support)
GEMINI_MODEL=gemini-2.5-flash

# Port d'écoute du serveur Node.js local
PORT=3000
